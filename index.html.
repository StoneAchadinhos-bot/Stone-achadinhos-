<script>
// CONFIGURE AQUI: substitua cada texto COLE_SEU_LINK_AFILIADO pelo link real correspondente.
const AFFILIATE_LINKS = [
  "COLE_SEU_LINK_AFILIADO_1", // 1. Organizador para casa
  "COLE_SEU_LINK_AFILIADO_2", // 2. Necessaire de beleza
  "COLE_SEU_LINK_AFILIADO_3", // 3. Suporte para celular
  "COLE_SEU_LINK_AFILIADO_4", // 4. Bolsa
  "COLE_SEU_LINK_AFILIADO_5", // 5. Fone
  "COLE_SEU_LINK_AFILIADO_6", // 6. Produto infantil
  "COLE_SEU_LINK_AFILIADO_7", // 7. Luminária
  "COLE_SEU_LINK_AFILIADO_8"  // 8. Garrafa
];
const cards=[...document.querySelectorAll('.product')], input=document.getElementById('searchInput'), empty=document.getElementById('emptyState');let activeCategory='todos';
document.querySelectorAll('.product .buy').forEach((a,i)=>{
  const url=AFFILIATE_LINKS[i];
  if(url && url.startsWith('https://') && url.includes('shopee.com.br')){
    a.href=url; a.classList.remove('needs-link'); a.textContent='Conferir oferta na Shopee ↗';
  }
});
function filterProducts(){const q=input.value.trim().toLocaleLowerCase('pt-BR');let count=0;cards.forEach(c=>{const ok=(activeCategory==='todos'||c.dataset.category===activeCategory)&&(c.dataset.name+' '+c.innerText).toLocaleLowerCase('pt-BR').includes(q);c.style.display=ok?'flex':'none';if(ok)count++});empty.style.display=count?'none':'block'}
document.querySelectorAll('.category').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('.category').forEach(x=>x.classList.remove('active'));b.classList.add('active');activeCategory=b.dataset.category;filterProducts()}));
input.addEventListener('input',filterProducts);document.getElementById('searchButton').addEventListener('click',filterProducts);document.getElementById('year').textContent=new Date().getFullYear();
document.querySelectorAll('.heart').forEach(b=>b.addEventListener('click',()=>{b.classList.toggle('saved');b.textContent=b.classList.contains('saved')?'♥':'♡'}));
function toast(msg){const t=document.getElementById('toast');t.textContent=msg;t.style.display='block';setTimeout(()=>t.style.display='none',3500)}
document.getElementById('applyLinks').addEventListener('click',()=>{let applied=0;document.querySelectorAll('.product .buy').forEach((a,i)=>{const field=document.getElementById('link'+(i+1));if(field&&field.value.trim()){let u;try{u=new URL(field.value.trim())}catch(e){toast('Um dos links não parece válido. Cole a URL completa, começando com https://.');return}if(!['https:'].includes(u.protocol)){toast('Use um link seguro que comece com https://.');return}a.href=u.href;a.classList.remove('needs-link');a.textContent='Conferir oferta na Shopee ↗';applied++}});toast(applied?applied+' link(s) aplicado(s) nesta visualização. Para publicar para todos, salve os links no HTML e hospede o arquivo.':'Cole pelo menos um link de afiliado nos campos acima.')});
</script>
</body></html>